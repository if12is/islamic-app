{
  "name": "tilawa-host",
  "private": true,
  "type": "module",
  "description": "Builds assets/tilawa/host.js, the on-device recitation engine the Recitation page runs inside a WebView.",
  "scripts": {
    "build": "esbuild src/host.js --bundle --format=iife --minify --target=es2020 --outfile=../../assets/tilawa/host.js"
  },
  "dependencies": {
    "@tilawa/core": "1.0.0-rc.1",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
