[{"id":363520,"date_gmt":"2026-10-11T04:53:48","link":"https:\/\/shahdnow.sa\/363520\/","title":{"rendered":"\u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u0623\u0633\u0628\u0648\u0639\u064a \u0644\u0623\u0626\u0645\u0629 \u0627\u0644\u062d\u0631\u0645\u064a\u0646 \u0627\u0644\u0634\u0631\u064a\u0641\u064a\u0646 \u0645\u0646 \u064a\u0648\u0645 \u0627\u0644\u0623\u062d\u062f 30 \u0631\u0628\u064a\u0639 \u0627\u0644\u0622\u062e\u0631 \u0625\u0644\u0649 \u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a 6 \u062c\u0645\u0627\u062f\u0649 \u0627\u0644\u0623\u0648\u0644\u0649 1448\u0647\u0640\u060c"},"content":{"rendered":"<p>\u0627\u0639\u0644\u0646\u062a \u0631\u0626\u0627\u0633\u0629 \u0627\u0644\u0634\u0624\u0648\u0646 \u0627\u0644\u062f\u064a\u0646\u064a\u0629 \u0628\u0627\u0644\u0645\u0633\u062c\u062f \u0627\u0644\u062d\u0631\u0627\u0645 \u0648\u0627\u0644\u0645\u0633\u062c\u062f \u0627\u0644\u0646\u0628\u0648\u064a \u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u0623\u0633\u0628\u0648\u0639\u064a \u0644\u0623\u0635\u062d\u0627\u0628 \u0627\u0644\u0641\u0636\u064a\u0644\u0629 \u0623\u0626\u0645\u0629 \u0627\u0644\u062d\u0631\u0645\u064a\u0646 \u0627\u0644\u0634\u0631\u064a\u0641\u064a\u0646\u060c \u0644\u0644\u0641\u062a\u0631\u0629 \u0645\u0646 \u064a\u0648\u0645 \u0627\u0644\u0623\u062d\u062f 30 \u0631\u0628\u064a\u0639 \u0627\u0644\u0622\u062e\u0631 \u0625\u0644\u0649 \u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a 6 \u062c\u0645\u0627\u062f\u0649 \u0627\u0644\u0623\u0648\u0644\u0649 1448\u0647\u0640\u060c \u0648\u0630\u0644\u0643 \u0636\u0645\u0646 \u062c\u0647\u0648\u062f\u0647\u0627 \u0641\u064a \u062a\u0646\u0638\u064a\u0645 \u0634\u0624\u0648\u0646 \u0627\u0644\u0625\u0645\u0627\u0645\u0629 \u0648\u062a\u064a\u0633\u064a\u0631 \u0645\u0639\u0631\u0641\u0629 \u062c\u062f\u0627\u0648\u0644 \u0627\u0644\u0635\u0644\u0648\u0627\u062a \u0644\u0644\u0645\u0635\u0644\u064a\u0646 \u0648\u0627\u0644\u0642\u0627\u0635\u062f\u064a\u0646.<\/p>\n<p>\u0623\u0648\u0